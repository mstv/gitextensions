<?xml version="1.0" encoding="utf-8"?>
<Project>

  <PropertyGroup Condition="'$(IsPerformanceTestProject)' == ''">
    <IsPerformanceTestProject>false</IsPerformanceTestProject>
    <IsPerformanceTestProject Condition="$(MSBuildProjectName.EndsWith('.PerformanceTests'))">true</IsPerformanceTestProject>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(IsIntegrationTestProject)' == ''">
    <IsIntegrationTestProject>false</IsIntegrationTestProject>
    <IsIntegrationTestProject Condition="$(MSBuildProjectName.EndsWith('.IntegrationTests'))">true</IsIntegrationTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsUnitTestProject)' == ''">
    <IsUnitTestProject>false</IsUnitTestProject>
    <IsUnitTestProject Condition="$(MSBuildProjectName.EndsWith('.UnitTests')) or $(MSBuildProjectName.EndsWith('.Tests'))">true</IsUnitTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
    <IsTestProject Condition="'$(IsUnitTestProject)' == 'true' or '$(IsIntegrationTestProject)' == 'true' or '$(IsPerformanceTestProject)' == 'true'">true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <EnableMicrosoftTestingExtensionsVSTestBridge>true</EnableMicrosoftTestingExtensionsVSTestBridge>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />

    <PackageReference Include="AwesomeAssertions" PrivateAssets="all" Publish="true" />
    <PackageReference Include="NSubstitute" PrivateAssets="all" Publish="true" />
    <PackageReference Include="NUnit" PrivateAssets="all" Publish="true" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" Publish="true" />
    <PackageReference Include="NUnit3TestAdapter" PrivateAssets="all" Publish="true" />
    <PackageReference Include="Microsoft.Testing.Extensions.VSTestBridge" PrivateAssets="all" Publish="true" />
    <PackageReference Include="Verify.NUnit" PrivateAssets="all" Publish="true" />

    <PackageReference Include="NUnit.ConsoleRunner" PrivateAssets="all" Publish="true" />
  </ItemGroup>

</Project>
